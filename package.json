{
  "name": "onco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:api && next dev",
    "build": "npm run build:api && next build",
    "build:api": "tsx scripts/build-api.ts",
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "start": "npx serve out",
    "fetch:structures": "tsx scripts/fetch-structures.ts",
    "mcp": "tsx mcp/server.ts",
    "fetch:openalex": "tsx scripts/fetch-openalex.ts",
    "fetch:trials": "tsx scripts/fetch-trials.ts",
    "validate:additions": "tsx scripts/validate-additions.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "d3-geo": "^3.1.1",
    "minisearch": "^7.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "topojson-client": "^3.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "description": "OnCo — the open map of oncology: technologies, targets, products, companies, institutions, pathways, trials, pairings, roadmaps, and ideas."
}
