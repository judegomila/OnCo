{
  "name": "onco-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for OnCo, the public cited knowledge graph of oncology. Tools: search, get_entity, list_kind, ask (cited answers), context (Markdown), compare. Reads the static API at onco.cc; no checkout needed.",
  "license": "MIT",
  "homepage": "https://onco.cc/api/",
  "repository": { "type": "git", "url": "https://github.com/judegomila/OnCo.git", "directory": "packages/onco-mcp" },
  "bugs": { "url": "https://github.com/judegomila/OnCo/issues" },
  "keywords": ["mcp", "model-context-protocol", "oncology", "cancer", "knowledge-graph", "clinical-trials", "onco"],
  "type": "module",
  "bin": { "onco-mcp": "./dist/onco-mcp.mjs" },
  "files": ["dist/", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "cd ../.. && npm run mcp:build",
    "test": "cd ../.. && npx vitest run packages/onco-mcp",
    "prepublishOnly": "npm run build && test -f dist/onco-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "publishConfig": { "access": "public" }
}
