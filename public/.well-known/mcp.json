{
  "name": "onco",
  "description": "OnCo: a public, cited knowledge graph of oncology. 18,949 records in 19 kinds, every fact dated and linked to a primary source. Not medical advice.",
  "version": "1",
  "homepage": "https://onco.cc",
  "repository": "https://github.com/judegomila/OnCo",
  "license": {
    "data": "CC-BY-NC-4.0",
