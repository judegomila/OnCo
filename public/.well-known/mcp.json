    "note": "Attribute as \"Data from OnCo (onco.cc)\"; commercial use of the data needs permission."
  },
  "servers": [
    {
      "type": "stdio",
      "command": "npx -y onco-mcp",
      "tools": [
        "search",
        "get_entity",
        "list_kind",
        "ask",
        "context",
        "compare"
      ]
    }
  ],
  "http": {
    "openapi": "https://onco.cc/api/v1/openapi.json",
    "search": "https://onco.cc/api/v1/search.json",
    "meta": "https://onco.cc/api/v1/meta.json",
    "llms": "https://onco.cc/llms.txt",
    "triples": "https://onco.cc/api/v1/onco.nt"
