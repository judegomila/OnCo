0001-6274-0184"}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5738-2968"},{"type":"ORCID","value":"0000-0001-6274-0184"},{"type":"ORCID","value":"0000-0002-1441-6512"},{"type":"ORCID","value":"0000-0002-2940-352X"},{"type":"ORCID","value":"0000-0002-3116-8602"},{"type":"ORCID","value":"0000-0002-3192-1019"},{"type":"ORCID","value":"0000-0002-5794-2109"},{"type":"ORCID","value":"0000-0002-8000-1040"},{"type":"ORCID","value":"0000-0003-1825-1206"},{"type":"ORCID","value":"0000-0003-1870-6098"},{"type":"ORCID","value":"0000-0003-2097-8439"},{"type":"ORCID","value":"0000-0003-4960-5468"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","full_text"]},"journalInfo":{"issue":"8","volume":"66","journalIssueId":2990439,"dateOfPublication":"2020 Aug","monthOfPublication":8,"yearOfPublication":2020,"journal":{"medlineAbbreviation":"Clin Chem","title":"Clinical chemistry","essn":"1530-8561","issn":"0009-9147","nlmid":"9421549","isoabbreviation":"Clin Chem"},"printPublicationDate":"2020-08-01"},"pubYear":"2020","pageInfo":"1012-1029","abstractText":"Digital PCR (dPCR) has developed considerably since the publication of the Minimum Information for Publication of Digital PCR Experiments (dMIQE) guidelines in 2013, with advances in instrumentation, software, applications, and our understanding of its technological potential. Yet these developments also have associated challenges; data analysis steps, including threshold setting, can be difficult and preanalytical steps required to purify, concentrate, and modify nucleic acids can lead to measurement error. To assist independent corroboration of conclusions, comprehensive disclosure of all relevant experimental details is required. To support the community and reflect the growing use of dPCR, we present an update to dMIQE, dMIQE2020, including a simplified dMIQE table format to assist researchers in providing key experimental information and understanding of the associated experimental process. Adoption of dMIQE2020 by the scientific community will assist in standardizing experimental protocols, maximize efficient utilization of resources, and further enhance the impact of this powerful technology.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","Journal Article"]},"grantsList":{"grant":[{"agency":"UK Government Department of Business, Energy and Industrial Strategy","grantId":"86652036","orderIn":0},{"agency":"BIOCEV","grantId":"CZ.1.05/1.1.00/02.0109","orderIn":0},{"agency":"ERDF","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Nucleic Acids","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AN","qualifierName":"analysis"}]}},{"majorTopic_YN":"N","descriptorName":"Polymerase Chain Reaction","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"MT","qualifierName":"methods"},{"majorTopic_YN":"Y","abbreviation":"SN","qualifierName":"statistics & numerical data"}]}},{"majorTopic_YN":"N","descriptorName":"Publications","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"ST","qualifierName":"standards"}]}},{"majorTopic_YN":"Y","descriptorName":"Guidelines as Topic"}]},"keywordList":{"keyword":["Digital Pcr","Dpcr","Miqe","Dmiqe"]},"chemicalList":{"chemical":[{"name":"Nucleic Acids","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Unpaywall","url":"https://academic.oup.com/clinchem/article-pdf/66/8/1012/33563181/hvaa125.pdf"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1093/clinchem/hvaa125"}]},"commentCorrectionList":{"commentCorrection":[{"source":"MED","id":"33141900","reference":"Clin Chem. 2020 Nov 1;66(