      "renderSha256": "f1fa3c17873cca8a22b56845ff09f4cc05fa4f128ec055d05c291b6e5d40c105"
    },
    {
      "id": "in-situ-vaccination-es",
      "kind": "reader-summary-entry",
      "name": "In situ vaccination (es)",
      "canonicalRecordId": "in-situ-vaccination",
      "language": "es",
      "available": true,
      "text": "Tratar un tumor de forma tan agresiva que el sistema inmunitario aprenda a atacar todos los demás, usando el propio tumor como vacuna.",
