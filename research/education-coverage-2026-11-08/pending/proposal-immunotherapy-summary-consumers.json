      "renderSha256": "75a8e1903a58844e2f237522fe29f0f998140c7386447b0489968f1c9c94f65b"
    },
    {
      "id": "in-situ-vaccination-fr",
      "kind": "reader-summary-entry",
      "name": "In situ vaccination (fr)",
      "canonicalRecordId": "in-situ-vaccination",
      "language": "fr",
      "available": true,
      "text": "Traiter une tumeur si vigoureusement que le système immunitaire apprend à attaquer toutes les autres, en utilisant la tumeur elle-même comme vaccin.",
