    {
      "id": "in-situ-vaccination-ar",
      "kind": "reader-summary-entry",
      "name": "In situ vaccination (ar)",
      "canonicalRecordId": "in-situ-vaccination",
      "language": "ar",
      "available": true,
      "text": "معالجة ورم واحد بقوة شديدة بحيث يتعلم الجهاز المناعي مهاجمة جميع الأورام الأخرى، باستخدام الورم نفسه كلقاح.",
