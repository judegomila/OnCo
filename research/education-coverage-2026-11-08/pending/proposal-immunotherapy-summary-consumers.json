    },
    {
      "id": "in-situ-vaccination-de",
      "kind": "reader-summary-entry",
      "name": "In situ vaccination (de)",
      "canonicalRecordId": "in-situ-vaccination",
      "language": "de",
      "available": true,
      "text": "Einen Tumor so aggressiv behandeln, dass das Immunsystem lernt, alle anderen anzugreifen, wobei der Tumor selbst als Impfstoff dient.",
