    {
      "id": "real-world-evidence-simple",
      "kind": "reader-summary-entry",
      "name": "Real-world evidence (simple)",
      "canonicalRecordId": "real-world-evidence",
      "language": "simple",
      "available": true,
      "text": "Health records and other routinely collected data can answer useful questions. Why people received different care and when follow-up began still matter."
    },
    {
      "id": "cross-trial-comparison-simple",
      "kind": "reader-summary-entry",
      "name": "Cross-trial comparison (simple)",
      "canonicalRecordId": "cross-trial-comparison",
      "language": "simple",
      "available": false,
      "text": null
    },
    {
      "id": "case-report-simple",
      "kind": "reader-summary-entry",
      "name": "Case report (simple)",
      "canonicalRecordId": "case-report",
      "language": "simple",
      "available": true,
      "text": "A report of what happened to one person can raise useful questions. It usually cannot separate the treatment effect from other possible explanations."
    },
    {
      "id": "meta-analysis-simple",
      "kind": "reader-summary-entry",
      "name": "Meta-analysis (simple)",
      "canonicalRecordId": "meta-analysis",
      "language": "simple",
      "available": true,
      "text": "A calculation that combines results from suitable studies. A precise average can still hide different results, bias or incompatible questions."
    },
    {
      "id": "controlled-perturbation-simple",
      "kind": "reader-summary-entry",
      "name": "Controlled perturbation experiment (simple)",
      "canonicalRecordId": "controlled-perturbation",
      "language": "simple",
      "available": true,
      "text": "Change a defined factor and compare the result with suitable controls. A real change in a laboratory test does not by itself show why it happened or that patients benefit."
    },
    {
      "id": "trial-phases-simple",
      "kind": "reader-summary-entry",
      "name": "Phase 1, 2 and 3 trials (simple)",
      "canonicalRecordId": "trial-phases",
      "language": "simple",
      "available": true,
      "text": "Trial phases describe the questions being studied, such as dose, safety and treatment comparison. A phase number does not promise benefit or tell you how treatment is assigned."
    },
    {
      "id": "randomised-trial-simple",
      "kind": "reader-summary-entry",
      "name": "Randomised trial (simple)",
      "canonicalRecordId": "randomised-trial",
      "language": "simple",
      "available": true,
      "text": "Chance assigns people to different treatment groups. This helps make a fair comparison, but does not guarantee identical groups or complete follow-up."
    },
    {
      "id": "preclinical-simple",
      "kind": "reader-summary-entry",
      "name": "Preclinical (simple)",
      "canonicalRecordId": "preclinical",
      "language": "simple",
      "available": true,
      "text": "Laboratory and other model studies can help explain a treatment and guide human studies. A model response does not establish benefit for patients."
    },
    {
      "id": "n-of-1-trial-simple",
      "kind": "reader-summary-entry",
      "name": "N-of-1 trial (simple)",
      "canonicalRecordId": "n-of-1-trial",
      "language": "simple",
      "available": true,
      "text": "A planned comparison in one person may use repeated treatment periods. Lasting effects or changes over time can prevent a fair comparison."
    },
    {
      "id": "trial-protocol-simple",
      "kind": "reader-summary-entry",
      "name": "Trial protocol and statistical analysis plan (simple)",
      "canonicalRecordId": "trial-protocol",
      "language": "simple",
      "available": true,
      "text": "The trial protocol is the rulebook a trial is run by, written before it starts, and the statistical analysis plan fixes how the answer will be calculated."
    },
    {
      "id": "non-inferiority-simple",
      "kind": "reader-summary-entry",
      "name": "Non-inferiority trial (simple)",
      "canonicalRecordId": "non-inferiority",
      "language": "simple",
      "available": true,
      "text": "A non-inferiority trial asks whether a new option avoids losing more than an agreed amount of benefit. Some loss can still be compatible with the data."
    },
    {
      "id": "intention-to-treat-simple",
      "kind": "reader-summary-entry",
      "name": "Intention-to-treat (ITT) and per-protocol analysis (simple)",
      "canonicalRecordId": "intention-to-treat",
      "language": "simple",
      "available": true,
      "text": "Count people in the group they were assigned to, even if treatment changed. Missing results still need careful handling."
    },
    {
      "id": "prespecified-vs-post-hoc-simple",
      "kind": "reader-summary-entry",
      "name": "Pre-specified vs post-hoc analysis (simple)",
      "canonicalRecordId": "prespecified-vs-post-hoc",
      "language": "simple",
      "available": true,
      "text": "Find out what was planned before the relevant results were seen, and what was explored afterwards. Useful discoveries still need an appropriate later test."
    },
    {
      "id": "subgroup-analysis-simple",
      "kind": "reader-summary-entry",
      "name": "Subgroup analysis (forest plots) (simple)",
      "canonicalRecordId": "subgroup-analysis",
      "language": "simple",
      "available": true,
      "text": "A treatment can be studied in groups defined by age, a marker or another feature. Different-looking results do not by themselves prove different treatment effects."
    }
  ],
