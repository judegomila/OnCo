    {
      "id": "ppv-simple",
      "kind": "reader-summary-entry",
      "name": "Positive predictive value (PPV) (simple)",
      "canonicalRecordId": "ppv",
      "language": "simple",
      "available": true,
      "text": "Among people with a positive result, how many really meet the condition being tested? The answer depends on the test and the population."
    },
    {
      "id": "false-discovery-rate-simple",
      "kind": "reader-summary-entry",
      "name": "False discovery rate (simple)",
      "canonicalRecordId": "false-discovery-rate",
      "language": "simple",
      "available": true,
      "text": "A multiple-testing rule limits the expected share of false findings among selected results under stated assumptions. It does not tell you which individual finding is false."
    },
    {
      "id": "roc-auc-simple",
      "kind": "reader-summary-entry",
      "name": "ROC-AUC, PR-AUC and time-dependent AUC (simple)",
      "canonicalRecordId": "roc-auc",
      "language": "simple",
      "available": true,
      "text": "A score can put people in the right order while getting their numerical risks wrong. Good ranking alone does not show that using the score helps patients."
    },
    {
      "id": "concordance-index-simple",
      "kind": "reader-summary-entry",
      "name": "C-index (concordance index), Harrell's and Uno's (simple)",
      "canonicalRecordId": "concordance-index",
      "language": "simple",
      "available": true,
      "text": "This measure checks whether predicted risk order matches observed event order. Unknown later outcomes need suitable handling."
    },
    {
      "id": "calibration-simple",
      "kind": "reader-summary-entry",
      "name": "Calibration: reliability diagrams and the Brier score (simple)",
      "canonicalRecordId": "calibration",
      "language": "simple",
      "available": true,
      "text": "A risk estimate needs checking against what actually happens over the same time. A correct overall average can hide errors in lower- and higher-risk groups."
    },
    {
      "id": "external-validation-simple",
      "kind": "reader-summary-entry",
      "name": "External validation (simple)",
      "canonicalRecordId": "external-validation",
      "language": "simple",
      "available": false,
      "text": null
    },
    {
