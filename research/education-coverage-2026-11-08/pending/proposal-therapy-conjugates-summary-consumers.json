    {
      "id": "chemotherapy-term-simple",
      "kind": "reader-summary-entry",
      "name": "Chemotherapy (simple)",
      "canonicalRecordId": "chemotherapy-term",
      "language": "simple",
      "available": true,
      "text": "Chemotherapy medicines affect different cell processes. They can kill cancer cells or slow their growth, and healthy cells can be affected too."
    },
    {
      "id": "cytotoxic-chemotherapy-simple",
      "kind": "reader-summary-entry",
      "name": "Cytotoxic chemotherapy (simple)",
      "canonicalRecordId": "cytotoxic-chemotherapy",
      "language": "simple",
      "available": true,
      "text": "These medicines can kill cancer cells or stop their growth. Their benefits and harms depend on the drug, treatment plan and cancer setting."
    },
    {
      "id": "chemotherapy-regimen-simple",
      "kind": "reader-summary-entry",
      "name": "Regimen and cycles (simple)",
      "canonicalRecordId": "chemotherapy-regimen",
      "language": "simple",
      "available": true,
      "text": "A regimen sets out the medicines, amounts and timing. A cycle is a defined period of treatment and recovery; its length depends on the plan."
    },
    {
      "id": "anthracycline-simple",
      "kind": "reader-summary-entry",
      "name": "Anthracyclines (doxorubicin, epirubicin) (simple)",
      "canonicalRecordId": "anthracycline",
      "language": "simple",
      "available": true,
      "text": "Anthracyclines affect DNA and an enzyme that cuts and reseals it. They can also harm the heart, sometimes after treatment has ended."
    },
    {
      "id": "taxane-simple",
      "kind": "reader-summary-entry",
      "name": "Taxanes (paclitaxel, docetaxel, nab-paclitaxel) (simple)",
      "canonicalRecordId": "taxane",
      "language": "simple",
      "available": true,
      "text": "Taxanes change how microtubules grow and shorten. These structures help cells divide and do other jobs, so healthy tissue can be affected too."
    },
    {
      "id": "alkylating-agent-simple",
      "kind": "reader-summary-entry",
      "name": "Alkylating agents and antimetabolites (simple)",
      "canonicalRecordId": "alkylating-agent",
      "language": "simple",
      "available": true,
      "text": "These are two different drug families. Alkylating agents attach chemical groups to molecules such as DNA; antimetabolites interfere with chemicals cells normally use."
    },
    {
      "id": "platinum-simple",
      "kind": "reader-summary-entry",
      "name": "Platinum agents (simple)",
      "canonicalRecordId": "platinum",
      "language": "simple",
      "available": true,
      "text": "Platinum medicines can attach to DNA and link sites together. That does not by itself show that a cell dies or that a treatment will work."
    },
    {
      "id": "topoisomerase-inhibitors-simple",
      "kind": "reader-summary-entry",
      "name": "Topoisomerase-I inhibitors (and ADC payloads) (simple)",
      "canonicalRecordId": "topoisomerase-inhibitors",
      "language": "simple",
      "available": true,
      "text": "These medicines can trap an enzyme on DNA during a temporary cut. Further damage depends on the medicine, exposure and cell response."
    },
    {
      "id": "fluorouracil-simple",
      "kind": "reader-summary-entry",
      "name": "Fluorouracil (5-FU) (simple)",
      "canonicalRecordId": "fluorouracil",
      "language": "simple",
      "available": true,
      "text": "Fluorouracil is the 1957 chemotherapy that remains the backbone of treatment for bowel, stomach, pancreatic, anal and head and neck cancers, and a cream for skin precancers."
    },
    {
      "id": "capecitabine-simple",
      "kind": "reader-summary-entry",
      "name": "Capecitabine (simple)",
      "canonicalRecordId": "capecitabine",
      "language": "simple",
      "available": true,
      "text": "The body converts capecitabine tablets into fluorouracil. Taking a medicine by mouth does not remove the risk of serious harm."
    },
    {
      "id": "tubulin-simple",
      "kind": "reader-summary-entry",
      "name": "Tubulin (microtubules) (simple)",
      "canonicalRecordId": "tubulin",
      "language": "simple",
      "available": true,
      "text": "Tubulin builds microtubules used in division, transport and cell organisation. Medicines can change these structures without every exposed cell dying."
    },
    {
      "id": "dose-dense-chemotherapy-simple",
      "kind": "reader-summary-entry",
      "name": "Dose-dense and metronomic chemotherapy (simple)",
      "canonicalRecordId": "dose-dense-chemotherapy",
      "language": "simple",
      "available": true,
      "text": "Dose-dense treatment shortens the gaps between treatments, while metronomic treatment uses repeated lower doses. Benefits, harms and supportive care depend on the particular regimen."
    },
    {
      "id": "antibody-tumor-penetration-simple",
      "kind": "reader-summary-entry",
      "name": "Antibody penetration into tumours (simple)",
      "canonicalRecordId": "antibody-tumor-penetration",
      "language": "simple",
      "available": false,
      "text": null
    },
    {
      "id": "adc-simple",
      "kind": "reader-summary-entry",
      "name": "Antibody-drug conjugate (ADC) (simple)",
      "canonicalRecordId": "adc",
      "language": "simple",
      "available": true,
      "text": "A guided missile: an antibody finds the cancer cell, gets swallowed, and releases a chemotherapy far too strong to give on its own."
    },
