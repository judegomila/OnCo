      "id": "ihc-simple",
      "kind": "reader-summary-entry",
      "name": "Immunohistochemistry (IHC) (simple)",
      "canonicalRecordId": "ihc",
      "language": "simple",
      "available": true,
      "text": "Staining a slice of tissue with antibodies so a protein shows up in colour under the microscope."
    },
    {
      "id": "cps-simple",
      "kind": "reader-summary-entry",
      "name": "Combined positive score (CPS) (simple)",
      "canonicalRecordId": "cps",
      "language": "simple",
      "available": true,
      "text": "CPS compares certain PD-L1-stained tumour and immune cells with the number of viable tumour cells. The assay and treatment setting determine how the score is used."
    },
    {
      "id": "tils-simple",
      "kind": "reader-summary-entry",
      "name": "Tumour-infiltrating lymphocytes (TILs) (simple)",
      "canonicalRecordId": "tils",
      "language": "simple",
      "available": true,
      "text": "Tumour-infiltrating lymphocytes are lymphocytes in tumour tissue. Location, cell identity, the measurement denominator and useful function are separate questions."
    },
    {
      "id": "core-needle-biopsy-simple",
      "kind": "reader-summary-entry",
      "name": "Core needle biopsy and fine-needle aspiration (FNA) (simple)",
      "canonicalRecordId": "core-needle-biopsy",
      "language": "simple",
      "available": true,
      "text": "A core needle takes small cylinders of tissue; a fine needle collects cells or fluid. Each samples a site, so a useful result depends on the question and the material collected."
    },
    {
      "id": "tumour-purity-simple",
      "kind": "reader-summary-entry",
      "name": "Tumour purity (simple)",
      "canonicalRecordId": "tumour-purity",
      "language": "simple",
      "available": false,
      "text": null
    },
    {
      "id": "h-and-e-staining-simple",
      "kind": "reader-summary-entry",
      "name": "H&E staining (haematoxylin and eosin) (simple)",
      "canonicalRecordId": "h-and-e-staining",
      "language": "simple",
      "available": false,
      "text": null
    },
    {
      "id": "digital-pathology-wsi-simple",
      "kind": "reader-summary-entry",
      "name": "Digital pathology and whole-slide images (WSI) (simple)",
      "canonicalRecordId": "digital-pathology-wsi",
      "language": "simple",
      "available": false,
      "text": null
    },
    {
      "id": "pd-l1-cps-simple",
      "kind": "reader-summary-entry",
      "name": "PD-L1 CPS (combined positive score) (simple)",
      "canonicalRecordId": "pd-l1-cps",
      "language": "simple",
      "available": true,
      "text": "CPS compares certain PD-L1-stained tumour and immune cells with viable tumour cells. Its reported score stops at 100, and its use depends on the assay and treatment setting."
    },
    {
      "id": "vacuum-assisted-breast-biopsy-simple",
      "kind": "reader-summary-entry",
      "name": "Vacuum-assisted breast biopsy systems (Mammotome, EnCor, Eviva, Brevera) (simple)",
      "canonicalRecordId": "vacuum-assisted-breast-biopsy",
      "language": "simple",
      "available": false,
      "text": null
    },
    {
      "id": "cfdna-simple",
      "kind": "reader-summary-entry",
      "name": "Cell-free DNA (cfDNA) (simple)",
      "canonicalRecordId": "cfdna",
      "language": "simple",
      "available": true,
      "text": "Cell-free DNA is short pieces of DNA floating in the blood shed by dying cells, and the small tumour-derived fraction is what liquid biopsies fish out."
    },
    {
      "id": "biopsy-after-neoadjuvant-therapy-simple",
      "kind": "reader-summary-entry",
      "name": "Tumour-bed biopsy after neoadjuvant therapy (simple)",
      "canonicalRecordId": "biopsy-after-neoadjuvant-therapy",
      "language": "simple",
      "available": true,
      "text": "A biopsy after drug treatment samples parts of the former breast tumour bed. A negative sample can miss remaining cancer and does not by itself establish that surgery can be omitted."
    },
    {
      "id": "tumor-stroma-ratio-simple",
      "kind": "reader-summary-entry",
      "name": "Tumour-stroma ratio (simple)",
      "canonicalRecordId": "tumor-stroma-ratio",
      "language": "simple",
      "available": true,
      "text": "This score estimates supporting tissue within a defined tumour field. It differs from an immune-cell score, and a study association does not prove which treatment to choose."
    },
    {
      "id": "surgical-resection-specimen-simple",
      "kind": "reader-summary-entry",
      "name": "Surgical resection specimen (simple)",
      "canonicalRecordId": "surgical-resection-specimen",
      "language": "simple",
      "available": true,
      "text": "Removed tissue is mapped into selected blocks for examination. Its report describes the examined material, rather than every cell in the tumour or body."
    },
    {
      "id": "blood-as-a-renewable-sample-simple",
      "kind": "reader-summary-entry",
      "name": "Serial blood sampling (simple)",
      "canonicalRecordId": "blood-as-a-renewable-sample",
      "language": "simple",
      "available": true,
      "text": "Later blood draws are new samples, each with a finite volume. Plasma, serum and blood cells supply different measurements and do not reproduce the local structure of tumour tissue."
