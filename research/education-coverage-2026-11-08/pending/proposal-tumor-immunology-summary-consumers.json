    {
      "id": "cancer-immunity-cycle-simple",
      "kind": "reader-summary-entry",
      "name": "The cancer-immunity cycle (simple)",
      "canonicalRecordId": "cancer-immunity-cycle",
      "language": "simple",
      "available": true,
      "text": "The cancer-immunity cycle maps steps from tumour material to immune recognition and killing. A positive test at one step does not show that every later step worked."
    },
    {
      "id": "cold-vs-hot-simple",
      "kind": "reader-summary-entry",
      "name": "Hot vs cold tumours (simple)",
      "canonicalRecordId": "cold-vs-hot",
      "language": "simple",
      "available": true,
      "text": "Hot, excluded and desert describe where specified immune cells were found in a sample. These patterns alone do not show cancer recognition, killing or treatment benefit."
    },
    {
      "id": "immune-exclusion-simple",
      "kind": "reader-summary-entry",
      "name": "Immune exclusion (simple)",
      "canonicalRecordId": "immune-exclusion",
      "language": "simple",
      "available": true,
      "text": "Immune exclusion means cells gather outside cancer-cell regions. Their position does not show what blocked access or which treatment would help."
    },
    {
      "id": "immune-desert-exclusion-simple",
      "kind": "reader-summary-entry",
      "name": "Cold tumours: immune deserts and exclusion (simple)",
      "canonicalRecordId": "immune-desert-exclusion",
      "language": "simple",
      "available": true,
      "text": "Few T cells in a sample and T cells gathered outside cancer-cell regions are different patterns. Cells that reach a tumour may still be restrained."
    },
    {
      "id": "neoadjuvant-adjuvant-simple",
      "kind": "reader-summary-entry",
      "name": "Neoadjuvant / adjuvant / perioperative (simple)",
      "canonicalRecordId": "neoadjuvant-adjuvant",
      "language": "simple",
      "available": true,
      "text": "Neoadjuvant treatment comes before surgery and adjuvant treatment after it. A regimen spanning both phases does not separately test how much each phase helped."
    },
    {
      "id": "nk-cell-recognition-simple",
      "kind": "reader-summary-entry",
      "name": "NK-cell recognition: missing self & stress ligands (simple)",
      "canonicalRecordId": "nk-cell-recognition",
      "language": "simple",
      "available": true,
      "text": "Natural killer cells combine receptor signals. Losing an inhibitory self signal does not guarantee killing: activating signals and the cells’ previous education also matter."
    },
    {
      "id": "abscopal-effect-simple",
      "kind": "reader-summary-entry",
      "name": "Abscopal effect (simple)",
      "canonicalRecordId": "abscopal-effect",
      "language": "simple",
      "available": true,
      "text": "When irradiating one tumour makes untreated tumours elsewhere shrink, through the immune system."
    },
    {
      "id": "in-situ-vaccination-simple",
      "kind": "reader-summary-entry",
      "name": "In situ vaccination (simple)",
      "canonicalRecordId": "in-situ-vaccination",
      "language": "simple",
      "available": true,
      "text": "In situ vaccination treats one tumour so aggressively that the immune system learns to attack every other one, using the tumour itself as the vaccine."
    },
    {
      "id": "tils-simple",
      "kind": "reader-summary-entry",
      "name": "Tumour-infiltrating lymphocytes (TILs) (simple)",
      "canonicalRecordId": "tils",
      "language": "simple",
      "available": true,
      "text": "Tumour-infiltrating lymphocytes are lymphocytes in tumour tissue. Location, cell identity, the measurement denominator and useful function are separate questions."
    },
    {
      "id": "cancer-associated-fibroblasts-simple",
      "kind": "reader-summary-entry",
      "name": "Cancer-associated fibroblasts (CAFs) (simple)",
      "canonicalRecordId": "cancer-associated-fibroblasts",
      "language": "simple",
      "available": true,
      "text": "Cancer-associated fibroblasts are stromal cells with varied states and effects. No single marker or abundance measurement shows that all of them suppress immunity or promote cancer."
    },
    {
      "id": "tumor-associated-macrophages-simple",
      "kind": "reader-summary-entry",
      "name": "Tumour-associated macrophages (TAMs) (simple)",
      "canonicalRecordId": "tumor-associated-macrophages",
      "language": "simple",
      "available": true,
      "text": "Macrophages in or around a tumour can have different states and effects. A marker count alone does not show that they suppress immunity or help cancer grow."
    },
    {
      "id": "nk-cell-simple",
      "kind": "reader-summary-entry",
      "name": "NK cell (simple)",
      "canonicalRecordId": "nk-cell",
      "language": "simple",
      "available": true,
      "text": "NK cells are fast-acting immune cells that destroy abnormal cells without training on a specific target, specialising in cells that have hidden from T cells."
    },
    {
      "id": "agretopicity-simple",
      "kind": "reader-summary-entry",
      "name": "Agretopicity (simple)",
      "canonicalRecordId": "agretopicity",
      "language": "simple",
      "available": true,
      "text": "A score compares predicted immune-display binding of an altered peptide and its normal counterpart. It does not show that the target is naturally displayed or recognised."
    },
    {
      "id": "adaptive-immune-resistance-simple",
      "kind": "reader-summary-entry",
      "name": "Adaptive immune resistance (simple)",
      "canonicalRecordId": "adaptive-immune-resistance",
      "language": "simple",
      "available": true,
      "text": "An immune attack can induce signals that restrain it. This feedback differs from a treatment that worked and later stopped working."
    },
    {
