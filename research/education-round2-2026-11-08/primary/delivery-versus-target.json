horAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Cell and Developmental Biology, Perelman School of Medicine at the University of Pennsylvania, Philadelphia, PA, USA."},{"affiliation":"Penn Cardiovascular Institute, Perelman School of Medicine at the University of Pennsylvania, Philadelphia, PA, USA."},{"affiliation":"Institute for Regenerative Medicine, Perelman School of Medicine at the University of Pennsylvania, Philadelphia, PA, USA."}]}},{"fullName":"Weissman D","lastName":"Weissman","firstName":"Drew","initials":"D","authorId":{"type":"ORCID","value":"0000-0002-1501-6510"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Perelman School of Medicine at the University of Pennsylvania, Philadelphia, PA, USA."}]}},{"fullName":"Parhiz H","lastName":"Parhiz","firstName":"Hamideh","initials":"H","authorId":{"type":"ORCID","value":"0000-0002-2880-2836"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Perelman School of Medicine at the University of Pennsylvania, Philadelphia, PA, USA."}]}},{"fullName":"Epstein JA","lastName":"Epstein","firstName":"Jonathan A","initials":"JA","authorId":{"type":"ORCID","value":"0000-0001-8637-4465"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Cell and Developmental Biology, Perelman School of Medicine at the University of Pennsylvania, Philadelphia, PA, USA."},{"affiliation":"Penn Cardiovascular Institute, Perelman School of Medicine at the University of Pennsylvania, Philadelphia, PA, USA."},{"affiliation":"Institute for Regenerative Medicine, Perelman School of Medicine at the University of Pennsylvania, Philadelphia, PA, USA."},{"affiliation":"Department of Medicine, Perelman School of Medicine at the University of Pennsylvania, Philadelphia, PA, USA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5116-0782"},{"type":"ORCID","value":"0000-0001-6683-7223"},{"type":"ORCID","value":"0000-0001-8637-4465"},{"type":"ORCID","value":"0000-0002-0175-4221"},{"type":"ORCID","value":"0000-0002-1501-6510"},{"type":"ORCID","value":"0000-0002-1609-1459"},{"type":"ORCID","value":"0000-0002-2880-2836"},{"type":"ORCID","value":"0000-0002-6598-3752"},{"type":"ORCID","value":"0000-0002-7156-4626"},{"type":"ORCID","value":"0000-0002-7844-6120"},{"type":"ORCID","value":"0000-0002-8317-0157"},{"type":"ORCID","value":"0000-0003-0241-3557"},{"type":"ORCID","value":"0000-0003-2107-3711"},{"type":"ORCID","value":"0000-0003-4159-9366"},{"type":"ORCID","value":"0000-0003-4504-232X"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data","recommended_reviews"]},"journalInfo":{"issue":"6576","volume":"375","journalIssueId":3289660,"dateOfPublication":"2022 Jan","monthOfPublication":1,"yearOfPublication":2022,"journal":{"medlineAbbreviation":"Science","title":"Science (New York, N.Y.)","essn":"1095-9203","issn":"0036-8075","nlmid":"0404511","isoabbreviation":"Science"},"printPublicationDate":"2022-01-01"},"pubYear":"2022","pageInfo":"91-96","abstractText":"Fibrosis affects millions of people with cardiac disease. We developed a therapeutic approach to generate transient antifibrotic chimeric antigen receptor (CAR) T cells in vivo by delivering modified messenger RNA (mRNA) in T cell–targeted lipid nanoparticles (LNPs). The efficacy of these in vivo–reprogrammed CAR T cells was evaluated by injecting CD5-targeted LNPs into a mouse model of heart failure. Efficient delivery of modified mRNA encoding the CAR to T lymphocytes was observed, which produced transient, effective CAR T cells in vivo. Antifibrotic CAR T cells exhibited trogocytosis and retained the target antigen as they accumulated in the spleen. Treatment with modified mRNA-targeted LNPs reduced fibrosis and restored cardiac function after injury. In vivo generation of CAR T cells may hold promise as a therapeutic platform to treat various diseases.","affiliation":"Departm