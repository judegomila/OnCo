{
  "headers": [
    {
      "source": "/((?!_next/|api/|sw\\.js$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-OnCo-License",
          "value": "CC-BY-NC-4.0; https://creativecommons.org/licenses/by-nc/4.0/"
        },
        {
          "key": "X-OnCo-Provenance",
          "value": "Every fact is dated and linked to a primary source on its page; cite the OnCo page URL and check the source before relying on anything that matters. Not medical advice."
        }
      ]
    },
    {
      "source": "/(logos|portraits|papers|globocan|trials|openalex|fda|regional|proposals|structures|schematics|icons|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
